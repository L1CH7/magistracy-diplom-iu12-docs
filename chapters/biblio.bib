@article{haurie1985relationship,
  author    = {Alain Haurie and Patrice Marcotte},
  title     = {On the Relationship between {Nash-Cournot} and {Wardrop} Equilibria},
  journal   = {Networks},
  volume    = {15},
  number    = {2},
  pages     = {295--308},
  year      = {1985},
  doi       = {10.1002/net.3230150209},
  annote    = {Теоретическая статья, исследующая фундаментальную математическую связь между равновесием Нэша-Курно (Nash-Cournot) из теории игр и транспортным равновесием Вардропа (Wardrop). В работе доказывается, что в условиях конкуренции на транспортной сети, по мере того как количество независимых агентов (пользователей) стремится к бесконечности, а влияние каждого отдельного агента на общую загруженность сети становится бесконечно малым, стратегическое равновесие Нэша-Курно асимптотически сходится к классическому пользовательскому транспортному равновесию (User Equilibrium), сформулированному Дж. Вардропом.}
}

