flowchart TD
    %% Стили
    classDef client fill:#e1f5fe,stroke:#0277bd,stroke-width:2px;
    classDef container fill:#fff3e0,stroke:#e65100,stroke-width:2px;
    classDef db fill:#e8f5e9,stroke:#2e7d32,stroke-width:2px;

    User((Пользователь))
    
    Client["Клиентское приложение<br/>(Qt Web / UI + MapLibre)"]:::client
    
    subgraph Docker["Серверный контур (Docker)"]
        direction TB
        Gateway["API Gateway / WS Proxy<br/>(Точка входа)"]:::container
        Core["Traffic Core<br/>(C++ Симулятор)"]:::container
        DataProc["Data Processor<br/>(Генератор тайлов)"]:::container
        DB[("PostgreSQL + PostGIS<br/>(БД геоданных)")]:::db
    end

    User <-->|Взаимодействие| Client
    
    %% Взаимодействие с клиентом
    Client <-->|WebSocket: Команды управления, JSON Телеметрия| Gateway
    Client <-->|HTTP: Векторные MVT тайлы карты| Gateway
    
    %% Внутренний роутинг в Docker
    Gateway <-->|"ZMQ (PUB/SUB & REQ-REP): Стрим метрик и API маршрутизации"| Core
    Gateway <-->|"HTTP API: Запрос тайлов"| DataProc
    
    %% Работа с базой
    DataProc <-->|"SQL (PostGIS MVT queries)"| DB
    DB -. "Офлайн-экспорт графа (Graph Builder)" .-> Core
    